{
  "manifest_version": 3,
  "name": "Vord · 快速添加",
  "version": "1.0.0",
  "description": "选中英文，通过右键菜单添加到本机 Vord 生词本。",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vord · 快速添加"
  }
}
